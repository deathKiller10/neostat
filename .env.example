# Postgres connection string from Neon (used for both local dev and production).
# Neon gives you postgresql://user:pass@host/dbname?sslmode=require -- paste it verbatim,
# config.py rewrites the driver prefix for you.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Google Gemini API key (https://aistudio.google.com/apikey), free tier.
GOOGLE_API_KEY=your-gemini-api-key-here

# Provider selection -- swappable behind the OCRProvider / LLMProvider interfaces.
OCR_PROVIDER=tesseract
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash

# Upload limits and validation.
MAX_UPLOAD_MB=10
MAX_PAGE_COUNT=3

# Financial validation tolerance: pass when |variance| <= max(ABS_TOL, REL_TOL * |reported|)
VALIDATION_ABS_TOL=1.00
VALIDATION_REL_TOL=0.005

# Pacing for scripts/run_samples.py, seconds between documents (avoid exhausting the
# Gemini free-tier per-minute/day quota on a full batch run).
SAMPLE_RUN_DELAY_SECONDS=6

# CORS
CORS_ALLOW_ORIGINS=*

# App metadata / environment
APP_ENV=development
LOG_LEVEL=INFO
